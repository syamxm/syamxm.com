#!/usr/bin/env node
"use strict";

const fs = require("fs");
const path = require("path");

const MAX_LENGTH = 80;
const REQUEST_TIMEOUT_MS = 60000;

const PROMPT = [
  "Write one short line for the scrolling update ticker on syamxm.com,",
  "the personal site of a final-year computer science student who self-hosts",
  "everything: the code, the CI pipeline and the server it runs on.",
  "Lowercase, plain language, no emoji, no quotes, no hashtags.",
  "Under 80 characters. Reply with the line only."
].join(" ");

function fail(reason) {
  console.error("generate-motd: " + reason);
  process.exit(1);
}

function clean(raw) {
  const text = String(raw == null ? "" : raw).trim();
  return text.replace(/^["'`]+/, "").replace(/["'`.]+$/, "").trim();
}

async function requestLine(host, model) {
  const res = await fetch(host.replace(/\/+$/, "") + "/api/generate", {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify({
      model,
      prompt: PROMPT,
      stream: false,
      keep_alive: "30m",
      options: { num_predict: 40, temperature: 0.8 }
    }),
    signal: AbortSignal.timeout(REQUEST_TIMEOUT_MS)
  });

  if (!res.ok) fail("ollama returned HTTP " + res.status);
  const body = await res.json();
  return clean(body.response);
}

function writeAtomic(target, contents) {
  const tmp = path.join(path.dirname(target), ".motd.json.tmp");
  fs.writeFileSync(tmp, contents, { mode: 0o644 });
  fs.renameSync(tmp, target);
}

async function main() {
  const host = process.env.OLLAMA_URL;
  const model = process.env.OLLAMA_MODEL;
  if (!host || !model) fail("OLLAMA_URL and OLLAMA_MODEL must be set");

  const text = await requestLine(host, model);

  if (!text) fail("empty output, keeping previous motd");
  if (/[\r\n]/.test(text)) fail("output contains newlines, keeping previous motd");
  if (text.length > MAX_LENGTH) fail("output is " + text.length + " chars, keeping previous motd");

  const target = path.join(__dirname, "..", "motd.json");
  writeAtomic(target, JSON.stringify({ text }) + "\n");
  console.log(text);
}

main().catch(function (error) {
  fail(error.message);
});
